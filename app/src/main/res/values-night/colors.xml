    <color name="brand_local">#2E9E76</color>
    <color name="brand_cloud">#E0922B</color>
    <color name="brand_blocked">#F2B8B5</color>

    <color name="primary">#2E9E76</color>
    <color name="on_primary">#00210F</color>
    <color name="secondary">#E0922B</color>
    <color name="on_secondary">#3A2A00</color>
    <color name="background">#101412</color>
    <color name="on_background">#E2E3DE</color>
    <color name="surface">#161B18</color>
    <color name="on_surface">#E2E3DE</color>
    <color name="surface_variant">#1F2622</color>
